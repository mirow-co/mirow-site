---
import { t, other, type Lang } from '../i18n';
import Analytics from '../components/Analytics.astro';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  altPath?: string; // caminho da mesma pagina no outro idioma (sem base, sem lang)
  image?: string; // og:image (caminho com base, ex: `${base}/foo.png`); default = logo
  schema?: object[]; // blocos JSON-LD adicionais (Article, Person, etc.)
}
const { lang, title, description = '', altPath = '', image, schema = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const L = (p: string) => `${base}/${lang}${p}`;
const oLang = other(lang);
const altHref = `${base}/${oLang}${altPath}`;
const _ = (k: string) => t[lang][k];

// URLs absolutas via Astro.site: corretas hoje (github.io/mirow-site) e
// se ajustam sozinhas quando site/base mudarem para mirow.com.br (Onda 3).
const abs = (p: string) => new URL(p, Astro.site).href;
const canonical = abs(Astro.url.pathname);
const altAbs = abs(altHref);
const enHref = lang === 'en' ? canonical : altAbs; // x-default aponta para o EN
const ogImage = abs(image ?? `${base}/mirow-logo-branco.png`);
const ogLocale = lang === 'pt' ? 'pt_BR' : 'en_US';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  name: 'Mirow & Co.',
  url: 'https://mirow.com.br',
  logo: abs(`${base}/mirow-logo-branco.png`),
  address: [
    { '@type': 'PostalAddress', addressLocality: 'Rio de Janeiro', addressCountry: 'BR' },
    { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressCountry: 'BR' },
  ],
  sameAs: ['https://br.linkedin.com/company/mirow-co-'],
  description:
    'Strategic management consulting firm — strategy, pricing, sourcing and innovation.',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Analytics />
    <title>{title} — Mirow & Co.</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mirow & Co." />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={oLang} href={altAbs} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <style is:global>
      :root {
        --navy: #020e66;
        --dark: #071c25;
        --cyan: #00adec;
        --lightblue: #aad5e8;
        --gray: #7f7f7f;
        --lightgray: #d2d2d2;
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: Arial, Helvetica, sans-serif;
        color: var(--dark);
        background: #fff;
        line-height: 1.55;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      .wrap {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 24px;
      }
      /* header */
      header.site {
        background: linear-gradient(180deg, #071c25 0%, #041545 100%);
        position: sticky;
        top: 0;
        z-index: 50;
      }
      header.site .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 18px 24px;
        max-width: 1120px;
        margin: 0 auto;
      }
      header.site img.logo {
        height: 26px;
        display: block;
      }
      header.site nav {
        display: flex;
        gap: 28px;
        align-items: center;
        flex-wrap: wrap;
      }
      header.site nav a {
        color: #fff;
        font-size: 15px;
      }
      header.site nav a:hover {
        color: var(--cyan);
      }
      header.site nav a.lang {
        color: var(--lightblue);
        border: 1px solid rgba(170, 213, 232, 0.4);
        border-radius: 3px;
        padding: 3px 10px;
        font-size: 13px;
      }
      /* hero */
      .hero {
        background: linear-gradient(180deg, #071c25 0%, #041545 55%, #020e66 100%);
        color: #fff;
        padding: 96px 0 110px;
      }
      .hero .kicker {
        color: var(--cyan);
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-size: 14px;
        margin-bottom: 18px;
      }
      .hero h1 {
        font-size: 56px;
        line-height: 1.1;
        max-width: 700px;
      }
      .hero .rule {
        width: 72px;
        height: 5px;
        background: var(--cyan);
        margin: 26px 0;
      }
      .hero p {
        color: var(--lightblue);
        font-size: 20px;
        max-width: 720px;
      }
      /* sections */
      section.block {
        padding: 72px 0;
      }
      section.block.alt {
        background: #f4f7fa;
      }
      h2.sec {
        color: var(--navy);
        font-size: 32px;
        margin-bottom: 8px;
      }
      p.sec-sub {
        color: var(--gray);
        margin-bottom: 40px;
        max-width: 720px;
      }
      .grid {
        display: grid;
        gap: 24px;
      }
      .grid.c3 {
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      }
      .card {
        border: 1px solid #e3e9ee;
        border-top: 4px solid var(--cyan);
        background: #fff;
        padding: 28px;
      }
      .card h3 {
        color: var(--navy);
        font-size: 20px;
        margin-bottom: 10px;
      }
      .card p {
        color: var(--dark);
        font-size: 15px;
      }
      .card a.more {
        display: inline-block;
        margin-top: 14px;
        color: var(--cyan);
        font-weight: bold;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      /* figures */
      .figures {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 24px;
      }
      .fig .n {
        color: var(--cyan);
        font-size: 56px;
        font-weight: bold;
      }
      .fig .d {
        color: var(--dark);
      }
      /* buttons */
      .btn {
        display: inline-block;
        background: var(--cyan);
        color: #fff;
        font-weight: bold;
        padding: 14px 28px;
        border: none;
        font-size: 15px;
        cursor: pointer;
      }
      .btn:hover {
        background: #0093c9;
      }
      /* forms */
      form.mirow {
        display: grid;
        gap: 16px;
        max-width: 560px;
      }
      form.mirow input,
      form.mirow textarea {
        font-family: Arial, sans-serif;
        font-size: 15px;
        padding: 12px;
        border: 1px solid #c9d4dc;
        width: 100%;
      }
      form.mirow textarea {
        min-height: 140px;
      }
      .demo-note {
        background: #eef7fc;
        border-left: 4px solid var(--cyan);
        padding: 12px 16px;
        color: var(--dark);
        font-size: 14px;
      }
      /* footer */
      footer.site {
        background: var(--dark);
        color: var(--lightblue);
        padding: 48px 0;
        margin-top: 40px;
      }
      footer.site .cols {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        align-items: center;
      }
      footer.site img {
        height: 22px;
      }
      footer.site .fine {
        color: var(--gray);
        font-size: 13px;
      }
      @media (max-width: 720px) {
        .hero h1 {
          font-size: 38px;
        }
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="bar">
        <a href={L('/')}><img class="logo" src={`${base}/mirow-logo-branco.png`} alt="Mirow & Co." /></a>
        <nav>
          <a href={L('/practices/')}>{_('nav.practices')}</a>
          <a href={L('/insights/')}>{_('nav.insights')}</a>
          <a href={L('/sectors/')}>{_('nav.sectors')}</a>
          <a href={L('/leaders/')}>{_('nav.leaders')}</a>
          <a href={L('/careers/')}>{_('nav.careers')}</a>
          <a href={L('/contact/')}>{_('nav.contact')}</a>
          <a class="lang" href={altHref}>{oLang === 'pt' ? 'Português' : 'English'}</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site">
      <div class="wrap cols">
        <img src={`${base}/mirow-logo-branco.png`} alt="Mirow & Co." />
        <div>{_('footer.offices')}</div>
        <div class="fine">© {new Date().getFullYear()} Mirow & Co. — {_('footer.rights')}</div>
      </div>
    </footer>
  </body>
</html>
