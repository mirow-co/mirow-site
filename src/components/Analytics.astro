---
// Medicao GA4 (issue mirow-marketing#3).
//
// Carrega o MESMO arquivo que as paginas publicadas em public/ usam
// (public/assets/mirow-analytics.js). Uma implementacao so: config das duas
// propriedades, Consent Mode v2 e os eventos de contato/formulario/leitura vivem
// la. Antes deste ajuste havia duas implementacoes, e a daqui nunca chegava ao ar
// porque o GitHub Pages publica public/ e nao o dist/ do Astro.
//
// Measurement ID e publico por natureza e mora no codigo (nao e segredo, R11).
// PUBLIC_GA_ID segue aceito como override para apontar um build a uma propriedade
// de teste, sem mexer no arquivo compartilhado.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const OVERRIDE = process.env.PUBLIC_GA_ID;
---

{
  OVERRIDE ? (
    <Fragment>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${OVERRIDE}`} />
      <script is:inline define:vars={{ OVERRIDE }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          wait_for_update: 500,
        });
        gtag('js', new Date());
        gtag('config', OVERRIDE);
      </script>
    </Fragment>
  ) : (
    <Fragment>
      <script is:inline src={`${base}/assets/mirow-analytics.js`} />
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-VK4QHHHS5X" />
    </Fragment>
  )
}
