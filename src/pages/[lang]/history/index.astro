---
// C23 (MMK-CONV006-C23): "Our history" parava em 2022 no site atual — precisa
// chegar a 2026, mas o Andreas explicitamente nao sabe ainda o que colocar nos
// marcos de 2023-2026 (novos socios/senior experts, GPTW, projetos-marco, etc.).
// Os 11 marcos de 2012-2022 abaixo sao os mesmos do site atual (real, nao inventado
// — extraidos de public/en/about-us/our-history e public/pt/sobre-nos/nossa-historia).
//
// "Nossa historia" e a 2a pagina mais vista do site (311 views/mes, jul/2026,
// MMK-CONV006-C32) — so atras da home. Estrutura pronta; falta so o conteudo novo.
import Base from '../../../layouts/Base.astro';
import history from '../../../data/history.json';
import { t, LANGS, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const _ = (k: string) => t[lang][k];
---

<Base lang={lang} title={_('history.title')} description={_('history.sub')} altPath={'/history/'}>
  <div class="hero" style="padding:64px 0">
    <div class="wrap"><h1 style="font-size:38px;max-width:900px">{_('history.title')}</h1></div>
  </div>
  <section class="block">
    <div class="wrap">
      <p class="sec-sub">{_('history.sub')}</p>
      <div style="display:grid;gap:0;max-width:820px">
        {
          history.map((h: any) => (
            <div style="display:grid;grid-template-columns:96px 1fr;gap:20px;padding:22px 0;border-top:1px solid #e3e9ee">
              <div style="color:var(--navy);font-size:24px;font-weight:bold">{h.year}</div>
              <p>{h[lang]}</p>
            </div>
          ))
        }
        {/* PENDENTE C23: conteudo 2023-2026 (Andreas/Felipe) */}
        <div style="display:grid;grid-template-columns:96px 1fr;gap:20px;padding:22px 0;border-top:1px solid #e3e9ee">
          <div style="color:var(--gray);font-size:24px;font-weight:bold">2023–2026</div>
          <p style="color:var(--gray);font-style:italic">{_('history.pending')}</p>
        </div>
      </div>
    </div>
  </section>
</Base>
