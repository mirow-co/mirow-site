---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { t, type Lang } from '../../../i18n';

export async function getStaticPaths() {
  const all = await getCollection('insights');
  return all.map((entry) => {
    const [lang, slug] = entry.id.split('/');
    return { params: { lang, slug }, props: { entry } };
  });
}
const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const _ = (k: string) => t[lang][k];
const { Content } = await render(entry);
---

<Base
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  altPath={`/insights/${entry.id.split('/')[1]}/`}
>
  <div class="hero" style="padding:64px 0">
    <div class="wrap">
      <div class="kicker">{_('insights.title')}</div>
      <h1 style="font-size:38px;max-width:900px">{entry.data.title}</h1>
    </div>
  </div>
  <section class="block">
    <div class="wrap" style="max-width:820px">
      <article class="prose">
        <Content />
      </article>
      {
        entry.data.original && (
          <p style="margin-top:32px">
            <a class="btn" href={entry.data.original}>
              {_('insights.download')}
            </a>
          </p>
        )
      }
    </div>
  </section>
  <style>
    .prose :global(p) {
      margin-bottom: 18px;
      font-size: 17px;
    }
    .prose :global(h2) {
      color: var(--navy);
      margin: 28px 0 12px;
    }
  </style>
</Base>
