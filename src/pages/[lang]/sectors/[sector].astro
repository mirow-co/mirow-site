---
import Base from '../../../layouts/Base.astro';
import { sectors } from '../../../data/sectors';
import { getCollection } from 'astro:content';
import { t, LANGS, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    sectors.map((s) => ({ params: { lang, sector: s.slug }, props: { slug: s.slug } }))
  );
}
const { slug } = Astro.props;
const lang = Astro.params.lang as Lang;
const _ = (k: string) => t[lang][k];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const L = (p: string) => `${base}/${lang}${p}`;
const abs = (p: string) => new URL(p, Astro.site).href;

const sector = sectors.find((s) => s.slug === slug)!;
const insights = (await getCollection('insights'))
  .filter((i) => i.id.startsWith(`${lang}/`) && i.data.sector === slug)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Mirow & Co.', item: abs(L('/')) },
    { '@type': 'ListItem', position: 2, name: _('sectors.title'), item: abs(L('/sectors/')) },
    { '@type': 'ListItem', position: 3, name: sector.name[lang], item: abs(L(`/sectors/${slug}/`)) },
  ],
};
---

<Base
  lang={lang}
  title={sector.name[lang]}
  description={_('sectors.sub')}
  altPath={`/sectors/${slug}/`}
  schema={[breadcrumb]}
>
  <div class="hero" style="padding:64px 0">
    <div class="wrap">
      <div class="kicker">{_('sectors.title')}</div>
      <h1 style="font-size:38px;max-width:900px">{sector.name[lang]}</h1>
    </div>
  </div>
  <section class="block">
    <div class="wrap">
      {
        insights.length > 0 ? (
          <div class="grid c3">
            {insights.map((p) => (
              <a class="card" href={L(`/insights/${p.id.split('/')[1]}/`)}>
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
                <span class="more">{_('insights.title')}</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="sec-sub">
            {lang === 'pt'
              ? 'Insights deste setor em breve.'
              : 'Insights for this sector are coming soon.'}
          </p>
        )
      }
    </div>
  </section>
</Base>
