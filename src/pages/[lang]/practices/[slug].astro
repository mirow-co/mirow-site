---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { t, type Lang } from '../../../i18n';

export async function getStaticPaths() {
  const all = await getCollection('practices');
  return all.map((entry) => {
    const [lang, slug] = entry.id.split('/');
    return { params: { lang, slug }, props: { entry } };
  });
}
const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const _ = (k: string) => t[lang][k];
const { Content } = await render(entry);
---

<Base
  lang={lang}
  title={entry.data.title}
  description={entry.data.tagline}
  altPath={`/practices/${entry.id.split('/')[1]}/`}
>
  <div class="hero" style="padding:64px 0">
    <div class="wrap">
      <div class="kicker">{_('nav.practices')}</div>
      <h1 style="font-size:44px">{entry.data.title}</h1>
      <div class="rule"></div>
      <p>{entry.data.tagline}</p>
    </div>
  </div>
  <section class="block">
    <div class="wrap" style="max-width:860px">
      <article class="prose"><Content /></article>
    </div>
  </section>
  <style>
    .prose :global(p) {
      margin-bottom: 16px;
      font-size: 17px;
    }
    .prose :global(h2) {
      color: var(--navy);
      margin: 30px 0 14px;
    }
    .prose :global(ul) {
      margin: 0 0 16px 22px;
    }
    .prose :global(li) {
      margin-bottom: 8px;
    }
  </style>
</Base>
