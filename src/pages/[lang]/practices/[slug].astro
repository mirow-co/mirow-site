---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { t, type Lang } from '../../../i18n';

export async function getStaticPaths() {
  const all = await getCollection('practices');
  return all.map((entry) => {
    const [lang, slug] = entry.id.split('/');
    return { params: { lang, slug }, props: { entry } };
  });
}
const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const _ = (k: string) => t[lang][k];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const L = (p: string) => `${base}/${lang}${p}`;
const { Content } = await render(entry);
const slug = entry.id.split('/')[1];
const abs = (p: string) => new URL(p, Astro.site).href;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: entry.data.title,
  description: entry.data.tagline,
  provider: { '@type': 'Organization', name: 'Mirow & Co.' },
  areaServed: 'BR',
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Mirow & Co.', item: abs(L('/')) },
    { '@type': 'ListItem', position: 2, name: _('home.practices'), item: abs(L('/practices/')) },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: abs(L(`/practices/${slug}/`)) },
  ],
};
---

<Base
  lang={lang}
  title={entry.data.title}
  description={entry.data.tagline}
  altPath={`/practices/${slug}/`}
  schema={[serviceSchema, breadcrumb]}
>
  <div class="hero" style="padding:64px 0">
    <div class="wrap">
      <div class="kicker">{_('home.practices')}</div>
      <h1 style="font-size:38px;max-width:900px">{entry.data.title}</h1>
    </div>
  </div>
  <section class="block">
    <div class="wrap" style="max-width:820px">
      <p style="font-size:18px;color:var(--gray);margin-bottom:24px">{entry.data.tagline}</p>
      <article class="prose"><Content /></article>
    </div>
  </section>
  <style>
    .prose :global(p) {
      margin-bottom: 18px;
      font-size: 17px;
    }
    .prose :global(h2) {
      color: var(--navy);
      margin: 28px 0 12px;
    }
    .prose :global(ul) {
      margin: 0 0 18px 20px;
    }
    .prose :global(li) {
      margin-bottom: 8px;
    }
  </style>
</Base>
